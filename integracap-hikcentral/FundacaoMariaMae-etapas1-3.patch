@@ -0,0 +1,103 @@
+-- Validações adicionais para impedir dados cadastrais inconsistentes.
+-- Execute após V2 e V3, sempre com backup do banco.
+-- Mantém compatibilidade com datas ISO (AAAA-MM-DD) e timestamps Unix em milissegundos.
+
+CREATE TRIGGER IF NOT EXISTS trg_assistido_validar_insert
+BEFORE INSERT ON assistido
+BEGIN
+    SELECT CASE
+        WHEN NEW.codigo_assistido IS NULL OR trim(NEW.codigo_assistido) = ''
+        THEN RAISE(ABORT, 'Código do assistido é obrigatório.')
+    END;
+
+    SELECT CASE
+        WHEN NEW.nome IS NULL OR trim(NEW.nome) = ''
+        THEN RAISE(ABORT, 'Nome do assistido é obrigatório.')
+    END;
+
+    SELECT CASE
+        WHEN NEW.data_nascimento IS NULL OR trim(NEW.data_nascimento) = ''
+          OR (
+              CASE
+                  WHEN trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*'
+                   AND length(trim(NEW.data_nascimento)) IN (12, 13)
+                  THEN date(CAST(trim(NEW.data_nascimento) AS INTEGER) / 1000, 'unixepoch')
+                  WHEN trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*'
+                  THEN NULL
+                  ELSE date(julianday(trim(NEW.data_nascimento)))
+              END
+          ) IS NULL
+          OR (
+              CASE
+                  WHEN trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*'
+                  THEN date(CAST(trim(NEW.data_nascimento) AS INTEGER) / 1000, 'unixepoch')
+                  ELSE date(julianday(trim(NEW.data_nascimento)))
+              END
+          ) > date('now')
+          OR (
+              NOT (trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*')
+              AND date(julianday(trim(NEW.data_nascimento))) <> substr(trim(NEW.data_nascimento), 1, 10)
+          )
+        THEN RAISE(ABORT, 'Data de nascimento inválida ou futura.')
+    END;
+
+    SELECT CASE
+        WHEN NEW.cpf IS NOT NULL
+         AND (trim(NEW.cpf) = '' OR length(NEW.cpf) <> 11 OR NEW.cpf GLOB '*[^0-9]*')
+        THEN RAISE(ABORT, 'CPF deve conter exatamente 11 dígitos numéricos.')
+    END;
+END;
+
+CREATE TRIGGER IF NOT EXISTS trg_assistido_validar_update
+BEFORE UPDATE OF codigo_assistido, nome, data_nascimento, cpf ON assistido
+BEGIN
+    SELECT CASE
+        WHEN NEW.codigo_assistido IS NULL OR trim(NEW.codigo_assistido) = ''
+        THEN RAISE(ABORT, 'Código do assistido é obrigatório.')
+    END;
+
+    SELECT CASE
+        WHEN NEW.nome IS NULL OR trim(NEW.nome) = ''
+        THEN RAISE(ABORT, 'Nome do assistido é obrigatório.')
+    END;
+
+    SELECT CASE
+        WHEN NEW.data_nascimento IS NULL OR trim(NEW.data_nascimento) = ''
+          OR (
+              CASE
+                  WHEN trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*'
+                   AND length(trim(NEW.data_nascimento)) IN (12, 13)
+                  THEN date(CAST(trim(NEW.data_nascimento) AS INTEGER) / 1000, 'unixepoch')
+                  WHEN trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*'
+                  THEN NULL
+                  ELSE date(julianday(trim(NEW.data_nascimento)))
+              END
+          ) IS NULL
+          OR (
+              CASE
+                  WHEN trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*'
+                  THEN date(CAST(trim(NEW.data_nascimento) AS INTEGER) / 1000, 'unixepoch')
+                  ELSE date(julianday(trim(NEW.data_nascimento)))
+              END
+          ) > date('now')
+          OR (
+              NOT (trim(NEW.data_nascimento) GLOB '[0-9]*'
+                   AND trim(NEW.data_nascimento) NOT GLOB '*[^0-9]*')
+              AND date(julianday(trim(NEW.data_nascimento))) <> substr(trim(NEW.data_nascimento), 1, 10)
+          )
+        THEN RAISE(ABORT, 'Data de nascimento inválida ou futura.')
+    END;
+
+    SELECT CASE
+        WHEN NEW.cpf IS NOT NULL
+         AND (trim(NEW.cpf) = '' OR length(NEW.cpf) <> 11 OR NEW.cpf GLOB '*[^0-9]*')
+        THEN RAISE(ABORT, 'CPF deve conter exatamente 11 dígitos numéricos.')
+    END;
+END;
