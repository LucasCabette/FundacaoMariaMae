+-- Faça uma cópia de segurança de data/fundacao_maria_mae.sqlite antes de executar.
+-- Esta migração preserva os registros existentes e adiciona a FK para assistido(id).
+-- Execute o arquivo inteiro em uma ferramenta SQLite (ex.: DB Browser for SQLite).
+
+PRAGMA foreign_keys = OFF;
+BEGIN TRANSACTION;
+
+CREATE TABLE integracao_preparacao_nova (
+    id TEXT PRIMARY KEY,
+    assistido_id INTEGER NOT NULL,
+    finalidade TEXT NOT NULL,
+    estado TEXT NOT NULL CHECK (estado IN ('EM_PREPARACAO','PREPARADO_LOCALMENTE','FALHA_PREPARACAO')),
+    http_status INTEGER,
+    codigo_erro TEXT,
+    mensagem TEXT,
+    foto_sha256 TEXT,
+    criado_em TEXT NOT NULL,
+    atualizado_em TEXT NOT NULL,
+    FOREIGN KEY (assistido_id) REFERENCES assistido(id)
+        ON UPDATE CASCADE ON DELETE RESTRICT
+);
+
+INSERT INTO integracao_preparacao_nova (
+    id, assistido_id, finalidade, estado, http_status, codigo_erro,
+    mensagem, foto_sha256, criado_em, atualizado_em
+)
+SELECT
+    id, assistido_id, finalidade, estado, http_status, codigo_erro,
+    mensagem, foto_sha256, criado_em, atualizado_em
+FROM integracao_preparacao;
+
+DROP TABLE integracao_preparacao;
+ALTER TABLE integracao_preparacao_nova RENAME TO integracao_preparacao;
+
+CREATE INDEX IF NOT EXISTS idx_integracao_preparacao_assistido
+    ON integracao_preparacao(assistido_id, criado_em);
+
+COMMIT;
+PRAGMA foreign_keys = ON;
+
+-- O resultado deve ser vazio. Se retornar linhas, há registros inconsistentes.
+PRAGMA foreign_key_check;
